<Window x:Class="BattleNetSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="战网账号切换器" Width="1100" Height="744" MinWidth="890" MinHeight="650"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Backdrop}" Foreground="{StaticResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Closing="WindowClosing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="7" CornerRadius="16"/>
  </shell:WindowChrome.WindowChrome>
  <Border x:Name="WindowFrame" Background="{StaticResource Backdrop}" BorderBrush="#B7C5DE">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Border.Style>
  <Grid>
    <Grid x:Name="Workspace" Margin="32,10,32,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="57"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="56"/>
      </Grid.RowDefinitions>

      <Grid MouseLeftButtonDown="DragWindow" Background="Transparent">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" Background="{StaticResource Blue}" CornerRadius="9">
            <Path Stroke="#FFFFFF" StrokeThickness="1.6" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M 0,4 L 15,4 M 11,0 L 15,4 11,8 M 0,12 L 15,12 M 4,8 L 0,12 4,16"/>
          </Border>
          <TextBlock Margin="10,0,0,0" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                     VerticalAlignment="Center" Text="Battle.net"/>
          <TextBlock Text="账号切换器" Margin="11,1,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
          <Button x:Name="LoginOtherButton" Content="登录其他账号" Style="{StaticResource Primary}" Height="34" Margin="0,0,8,0"
                  ToolTip="先保存当前会话或更新一个旧会话，再登录另一个账号" ToolTipService.ShowOnDisabled="True" Click="ShowLoginOther"/>
          <Button x:Name="ClientButton" Content="启动战网" Style="{StaticResource Button}" Background="#F4F7FC" Height="34" Click="StartClient"/>
          <Button x:Name="SettingsButton" Content="设置战网路径" Style="{StaticResource Quiet}" Height="34" Margin="5,0,4,0" Click="ShowSettings"/>
          <Button x:Name="MinimizeButton" AutomationProperties.Name="最小化" ToolTip="最小化"
                  Style="{StaticResource WindowControlButton}" Click="MinimizeWindow">
            <Path Style="{StaticResource WindowControlGlyph}" Data="M3,8 H13"/>
          </Button>
          <Button x:Name="MaximizeButton" Click="MaximizeWindow">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
                <Setter Property="AutomationProperties.Name" Value="最大化"/>
                <Setter Property="ToolTip" Value="最大化"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="AutomationProperties.Name" Value="还原窗口"/>
                    <Setter Property="ToolTip" Value="还原窗口"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <Path>
              <Path.Style>
                <Style TargetType="Path" BasedOn="{StaticResource WindowControlGlyph}">
                  <Setter Property="Data" Value="M3,4 Q3,3 4,3 H12 Q13,3 13,4 V12 Q13,13 12,13 H4 Q3,13 3,12 Z"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                      <Setter Property="Data" Value="M6,4.5 V4 Q6,3 7,3 H12 Q13,3 13,4 V9 Q13,10 12,10 H11.5 M3,7 Q3,6 4,6 H9 Q10,6 10,7 V12 Q10,13 9,13 H4 Q3,13 3,12 Z"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
          </Button>
          <Button x:Name="CloseButton" AutomationProperties.Name="关闭" ToolTip="关闭"
                  Style="{StaticResource WindowControlButton}" Click="CloseWindow">
            <Path Style="{StaticResource WindowControlGlyph}" Data="M4,4 L12,12 M12,4 L4,12"/>
          </Button>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="{StaticResource Paper}" CornerRadius="22">
        <Border.Effect>
          <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Color="#6D80AD" Opacity=".25"/>
        </Border.Effect>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="57*"/>
          <ColumnDefinition Width="43*"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="AccountPane" Margin="30,27,30,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Margin="1,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="已保存账号" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1"/>
              <TextBlock x:Name="AccountCount" Style="{StaticResource Caption}" FontFamily="Segoe UI" FontSize="14" Margin="9,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="AddButton" HorizontalAlignment="Right" Style="{StaticResource Button}" Content="＋ 保存当前登录" Click="ShowCapture"/>
          </Grid>

          <ListBox x:Name="AccountsList" Grid.Row="1" SelectionChanged="SelectionChanged" AutomationProperties.Name="已保存账号"
                   Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="11,8"/>
                <Setter Property="Margin" Value="0,0,2,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Row" Background="#FFFDF8" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
                        <Grid Margin="{TemplateBinding Padding}">
                          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions>
                          <ContentPresenter/>
                          <Border x:Name="Radio" Grid.Column="1" Width="16" Height="16" CornerRadius="8" BorderThickness="1.2"
                                  BorderBrush="#A4A8BC" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Ellipse x:Name="Dot" Fill="{StaticResource Blue}" Width="8" Height="8" Opacity="0"/>
                          </Border>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#A0ABE9"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="#EFF1FF"/>
                          <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Blue}"/>
                          <Setter TargetName="Radio" Property="BorderBrush" Value="{StaticResource Blue}"/>
                          <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="Row" Property="BorderThickness" Value="2"/>
                          <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Blue}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="AutomationProperties.ItemStatus" Value="当前登录"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="53"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border x:Name="Avatar" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#E1E8FB" CornerRadius="8">
                    <Grid>
                      <TextBlock x:Name="AvatarInitial" Text="{Binding Initial}" Foreground="#324CA9" FontSize="17" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Path x:Name="AvatarCheck" Data="M1,7 L6,12 L15,3" Width="17" Height="17" Stretch="Uniform"
                            Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0">
                      <Run Text="{Binding RegionName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SavedAt, Mode=OneWay, StringFormat={}{0:MM.dd HH:mm} 已保存}"/>
                    </TextBlock>
                  </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Avatar" Property="Background" Value="{StaticResource Blue}"/>
                    <Setter TargetName="AvatarInitial" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="AvatarCheck" Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border x:Name="EmptyState" Grid.Row="1" Background="#F5F1E9" BorderBrush="#ECE4D7" BorderThickness="1" CornerRadius="12" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border CornerRadius="12" Width="46" Height="46" Background="#E7EBFC" Margin="0,0,0,12">
                <Path Data="M2 1H20V17H2Z M6 6H16 M6 11H13 M0 4H2 M0 9H2 M0 14H2" Stroke="#263FE2" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text="还没有保存的账号" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center"/>
              <TextBlock Text="在战网登录并勾选保持登录，从托盘退出后，保存当前登录。" Style="{StaticResource Caption}"
                         Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="270" LineHeight="23"/>
            </StackPanel>
          </Border>

          <Border x:Name="Feedback" Grid.Row="2" Visibility="Collapsed" Margin="0,8,0,0" CornerRadius="8" Padding="10,8">
            <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" FontSize="13" AutomationProperties.LiveSetting="Polite"/>
          </Border>
          <StackPanel x:Name="AccountActions" Grid.Row="3" Margin="0,12,0,0">
            <Border Height="1" Margin="0,0,0,7" Background="{StaticResource Line}"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="EditButton" Content="编辑" Style="{StaticResource Quiet}" Padding="9,0" Height="34" Click="ShowEdit"/>
              <Button x:Name="RefreshButton" Content="更新会话" Style="{StaticResource Quiet}" Padding="9,0" Height="34" Click="ShowRefresh"/>
              <Button x:Name="DeleteButton" Content="移除" Style="{StaticResource Quiet}" Foreground="{StaticResource Error}" Padding="9,0" Height="34" Click="ShowDelete"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <Border Grid.Column="1" Background="{StaticResource Blush}" CornerRadius="0,22,22,0"/>
        <Grid Grid.Column="1" Margin="26,31,26,22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="PreviewName" Text="未选择账号" FontSize="25" FontWeight="Bold" AutomationProperties.HeadingLevel="Level2"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
              <TextBlock x:Name="PreviewRegion" Margin="0,4,0,0" Style="{StaticResource Caption}" FontSize="14"/>
            </StackPanel>
            <TextBlock x:Name="PreviewState" Grid.Column="1" Text="待选择" Style="{StaticResource Caption}" Margin="12,6,0,0"/>
          </Grid>

          <Viewbox Grid.Row="1" MaxWidth="365" MaxHeight="264" Margin="0,9" StretchDirection="DownOnly" Focusable="False" IsHitTestVisible="False">
            <Canvas Width="350" Height="244">
              <Ellipse Width="218" Height="214" Canvas.Left="62" Canvas.Top="14" Fill="#FBE8E1"/>
              <Ellipse Width="234" Height="153" Canvas.Left="58" Canvas.Top="50" Stroke="#EAB6AF" StrokeThickness="1" StrokeDashArray="2,5">
                <Ellipse.RenderTransform><RotateTransform Angle="-18" CenterX="117" CenterY="76"/></Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="199" Height="24" Canvas.Left="78" Canvas.Top="193" Fill="#36A75459">
                <Ellipse.Effect><BlurEffect Radius="17"/></Ellipse.Effect>
              </Ellipse>
              <Path Fill="#EF866D" Data="M 63,64 L 65,72 73,74 65,76 63,84 61,76 53,74 61,72 Z"/>
              <Path Fill="#D16E5E" Data="M 292,144 L 294,151 301,153 294,155 292,162 290,155 283,153 290,151 Z"/>
              <Ellipse Width="6" Height="6" Canvas.Left="255" Canvas.Top="29" Fill="#E17C6C"/>
              <Ellipse Width="5" Height="5" Canvas.Left="69" Canvas.Top="181" Fill="#D78175"/>
              <Border Canvas.Left="124" Canvas.Top="62" Width="150" Height="114" Background="#E88473" BorderBrush="#C86A61" BorderThickness="1" CornerRadius="13">
                <Border.RenderTransform><RotateTransform Angle="17" CenterX="75" CenterY="57"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect Color="#A64C49" BlurRadius="13" Opacity=".2" ShadowDepth="3"/></Border.Effect>
                <Grid>
                  <Border Margin="9" BorderThickness="1" BorderBrush="#F6B6A3" CornerRadius="9"/>
                  <Path Stroke="#FAD4C8" StrokeThickness="1.3" Data="M107 23H126 M107 28H126 M110 33H126 M114 38H126"/>
                </Grid>
              </Border>
              <Border x:Name="PreviewCard" Canvas.Left="83" Canvas.Top="59" Width="158" Height="127" Background="#314BE7"
                      BorderBrush="#233ABB" BorderThickness="1" CornerRadius="13" RenderTransformOrigin=".5,.5">
                <Border.RenderTransform><TransformGroup><RotateTransform Angle="-11"/><TranslateTransform x:Name="CardSlide"/></TransformGroup></Border.RenderTransform>
                <Border.Effect><DropShadowEffect Color="#34397F" BlurRadius="16" Opacity=".3" ShadowDepth="5"/></Border.Effect>
                <Grid>
                  <Border Margin="9" CornerRadius="8" BorderBrush="#6680F4" BorderThickness="1"/>
                  <Path Stroke="#617AF4" StrokeThickness="1" Data="M10 86H146 M10 91H146"/>
                  <TextBlock x:Name="CardRegion" FontFamily="Georgia" FontWeight="Bold" FontSize="42" Foreground="#FFFBEE"
                             Margin="22,25,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="—"/>
                  <TextBlock FontFamily="Segoe UI" Text="BATTLE.NET" Foreground="#EBEFFF" FontSize="10" FontWeight="Bold" Margin="23,0,0,19"
                             VerticalAlignment="Bottom"/>
                  <Path Stroke="#EEF1FF" StrokeThickness="1.3" Data="M117 32H136 M132 28L136 32 132 36 M117 40H136 M121 36L117 40 121 44"/>
                </Grid>
              </Border>
              <Border x:Name="AppliedSeal" Visibility="Collapsed" Canvas.Left="213" Canvas.Top="158" Padding="10,5"
                      BorderBrush="#A63B34" BorderThickness="2" CornerRadius="3" Background="#FFF1E3" RenderTransformOrigin=".5,.5">
                <Border.RenderTransform><TransformGroup><RotateTransform Angle="-9"/><ScaleTransform x:Name="SealScale"/></TransformGroup></Border.RenderTransform>
                <TextBlock Text="当前登录" Foreground="#A63B34" FontSize="15" FontWeight="Bold"/>
              </Border>
            </Canvas>
          </Viewbox>

          <Button x:Name="SwitchButton" Grid.Row="2" Style="{StaticResource Primary}" Content="切换并启动  →" Click="SwitchAccount"/>
        </Grid>
      </Grid>

      <DockPanel Grid.Row="2" Margin="2,0,0,0" VerticalAlignment="Center">
        <Border x:Name="LauncherIndicator" Width="16" Height="16" CornerRadius="8" VerticalAlignment="Center" Margin="0,0,7,0">
          <Path x:Name="LauncherGlyph" Width="9" Height="9" Stretch="Uniform" Stroke="White" StrokeThickness="1.4"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="LauncherStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Grid>

    <Grid x:Name="Overlay" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="OverlayKeyDown">
      <Border CornerRadius="{Binding CornerRadius, ElementName=WindowFrame}" Background="#77212741"/>
      <Border x:Name="Dialog" Width="448" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="17" Background="{StaticResource Paper}">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity=".28"/></Border.Effect>
        <StackPanel>
          <TextBlock x:Name="DialogTitle" FontSize="24" FontWeight="Bold" AutomationProperties.HeadingLevel="Level2"/>
          <TextBlock x:Name="DialogCopy" Margin="0,9,0,0" Style="{StaticResource Caption}" FontSize="14" TextWrapping="Wrap" LineHeight="23"/>
          <StackPanel x:Name="Fields" Margin="0,17,0,0">
            <Label x:Name="NameLabel" Content="账号名称" Target="{Binding ElementName=NameInput}" Padding="0" Foreground="{StaticResource Ink}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="NameInput" Height="40" MaxLength="36" Style="{StaticResource Entry}"
                     FontSize="15" AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}"/>
            <TextBlock Text="地区" Margin="0,13,0,7" FontWeight="SemiBold"/>
            <UniformGrid Columns="4">
              <RadioButton x:Name="China" Content="国服" Style="{StaticResource RegionChoice}" GroupName="Region"/>
              <RadioButton x:Name="Americas" Content="美洲" Style="{StaticResource RegionChoice}" GroupName="Region"/>
              <RadioButton x:Name="Europe" Content="欧洲" Style="{StaticResource RegionChoice}" GroupName="Region"/>
              <RadioButton x:Name="Asia" Content="亚洲" Style="{StaticResource RegionChoice}" GroupName="Region" Margin="0"/>
            </UniformGrid>
          </StackPanel>
          <TextBlock x:Name="DialogError" Margin="0,12,0,0" Foreground="{StaticResource Error}" TextWrapping="Wrap"
                     Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,19,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource Quiet}" Content="取消" Click="CloseDialogClick"/>
            <Button x:Name="ConfirmButton" Style="{StaticResource Primary}" Height="40" Margin="7,0,0,0" Click="ConfirmDialog" IsDefault="True"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
  </Border>
</Window>
